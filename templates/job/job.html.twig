{% if is_granted('ROLE_ADMIN') %}
<p>Welcome back {{ app.user.userName}}</p> 
<table class="table table-striped ">
  <thead>
    <tr class="d-flex">
      <th scope="col" class="flex-fill">Job Id</th>
      <th scope="col" class="flex-fill">Company Image</th>
      <th scope="col" class="flex-fill">Job Title</th>
      <th scope="col" class="flex-fill">Company Name</th>
      <th scope="col" class="flex-fill">Date of Posted</th>
      <th scope="col" class="flex-fill">Action</th>
    </tr>
  </thead>
  {% for job in jobs %}
  <tbody>
    <tr class="d-flex">
    
      <th class="flex-fill text-center" scope="row">{{job.id}}</th>
      <td class="flex-fill text-center"> <img src="{{asset('images/' ~ job.jobIamge)}}" class="img-fluid rounded-start" alt="It was a Job image">
   </td>
      <td class="flex-fill text-center">{{job.jobName}}</td>
      <td class="flex-fill text-center">{{job.companyName}}</td>
      <td class="flex-fill text-center">{{job.jobPostedDate|date('F j, Y, g:i a')}}</td>
      <td class="flex-fill text-center">
      <a class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center" href="{{ path('app_detail',{"id": job.id}) }}"><span class="mx-auto">Detail</span></a> 
      <a class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center" href="{{ path('app_edit',{"id": job.id}) }}"><span class="mx-auto">Edit</span></a> 
      <a class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center" href="{{ path('app_delete',{"id": job.id}) }}"><span class="mx-auto">Delete</span></a>  

      </td>
    </tr>
   
  </tbody>
  {% endfor %}
</table>
{% else %}



<div class="d-flex justify-content-center align-content-center flex-wrap w-80 mx-auto">
            


 {% if jobs is empty %}

<h3 class="bg-warning">There is no Job at the moment.</h3>

{% else %}


{% for job in jobs %}



<div class="row">
              <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="card mb-1 text-center " >
                        <img src="{{asset('images/' ~ job.jobIamge)}}" class="img-fluid-card rounded-start" alt="It was a Job image">
                    
                    </div> 
              </div>

              <div class="col-lg-4 col-md-6 col-sm-6  h-100">
                        
                    <div class="card-body d-flex flex-column">
                          <h6 class="card-title"><b>{{job.jobName}}</b></h6>
                          <p class="card-title"><i class="bi bi-buildings "></i>{{ job.companyName}}</p>
                          <p class="card-text"><i class="bi bi-geo-alt "></i>{{ job.jobLocation}}</p>
                          <p class="card-text"><small class="text-muted"><i class="bi bi-calendar-date "></i>{{ job.jobPostedDate|date('F j, Y, g:i a')}}</small></p>
                        
                    </div>
                    <div class=" mt-auto mx-3 mb-3">
                      <a href="/details/{{job.id}}" class="btn btn-outline-info form-control-sm btn-block text-dark form-border form-btn-border px-sm-5 btn-sm "><span class="mx-auto">Detail</span>
                            </a>
                    </div>
                    
              </div>
</div>


{% endfor %}

{% endif %}
{% endif %}
</div>
