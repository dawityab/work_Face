{% extends 'base.html.twig' %}

{% block title %}Hello JobController!{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
     <a class="navbar-brand" href="/"><img src="{{ asset('images/jf-image.png') }}" alt="Image" class="logo-img">
    <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
       <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
       {% if is_granted('ROLE_ADMIN') %}   
        <li class="nav-item">
          <a class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm" aria-current="page" href="/create"><span>Add New Job</span></a>
        </li>
        {% endif %}
        <li class="nav-item">
          <a  class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm "
   href="/{{app.user ? 'logout' : 'login'}}">
<span>{{app.user ? 'Logout' :  'Login'}}</span>
</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm" href="/"><span>Home</span></a>
        </li>
       
      </ul>
    </div>
  </div>
</nav>

<div class="container admin-page">
{% if is_granted('ROLE_ADMIN') %}

<p>Welcome back {{ app.user.userName}}</p> 

{% if jobs is empty %}
<p>Sorry, there is no jobs on the table.</p>
{% endif %}
 
<table class="table table-bordered table-striped admin-page">
  <thead>
    <tr>
      <th>Job Id</th>
      <th>Job Title</th>
      <th>Company Name</th>
      <th>Date of Posted</th>
      <th>Action</th>
    </tr>
  </thead>
  {% for job in jobs %}
  <tbody class="admin-page">
    <tr >
    
      <td class="admin-page">{{job.id}}</td>
      {# <td class="flex-fill"> <img src="{{asset('images/' ~ job.jobIamge)}}" class="img-fluid rounded-start" alt="It was a Job image"></td> #}
      <td class="admin-page">{{job.jobName}}</td>
      <td class="admin-page">{{job.companyName}}</td>
      <td class="admin-page">{{job.jobPostedDate|date('F j, Y, g:i a')}}</td>
      <td >
      <a class="btn btn-outline-info form-control-sm text-dark form-border  form-btn-border px-sm-5 btn-sm  d-flex justify-content-center" href="{{ path('app_detail',{"id": job.id}) }}"><span class="mx-auto">Detail</span></a> 
      <a class="btn btn-outline-info form-control-sm text-dark form-border  form-btn-border px-sm-5 btn-sm  d-flex justify-content-center" href="{{ path('app_edit',{"id": job.id}) }}"><span class="mx-auto">Edit</span></a> 
      <a class="btn btn-outline-info form-control-sm text-dark form-border  form-btn-border px-sm-5 btn-sm  d-flex justify-content-center" href="{{ path('app_delete',{"id": job.id}) }}"><span class="mx-auto">Delete</span></a>  

      </td>
    </tr>
   
  </tbody>
  {% endfor %}
</table>
</div>
{% else %}



<div class=" container job-card-container text-secondary d-flex justify-content-center align-content-center flex-wrap w-80 mx-auto">
  
<div class="row">    
  <div class="col-lg">  

{% if (not is_granted('ROLE_USER')) and  (jobs is empty) %}
    <h5 class="bg-info text-dark job-info">Sorry! There is no available jobs at this time.</h5>
{% endif %}




{% if (is_granted('ROLE_USER')) and  (jobs is empty) %}

<h5 class="bg-info text-dark job-info">Sorry! {{ app.user.userName}} there is no available jobs at this time.</h5>

{% endif %}
</div>
</div>
</div>


{% if (is_granted('ROLE_USER')) and  (jobs is not empty) %}
<div class="alert alert-primary" role="alert">
  <strong>Welcome back!</strong> {{ app.user.userName}}, search your dream job here.
</div>





 

<div class="container-fluid job-card-container text-secondary d-flex justify-content-center align-content-center flex-wrap w-80 mx-auto">
  
      <div class="row">
          {# <div class="card-container"> #}
          {% for job in jobs %}
      <div class="card d-flex shadow-lg" style="width: 16rem;">
          <img src="{{asset('images/' ~ job.jobIamge)}}" class="card-img-top mx-auto card-image-size" alt="Image">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><b>{{job.jobName}}</b></h5>
            <p class="card-text">{{job.companyName}}</p>
            <div class="mt-auto">
                                                      
                <a href="/details/{{job.id}}" class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm"><span>Detail</span></a>
            </div>                      
          </div>
        </div>
        {% endfor %}
         
         </div>

     
</div>
 
{% endif %}

{% if (not is_granted('ROLE_USER')) and  (jobs is not empty) %}


<div class="container-fluid job-card-container text-secondary d-flex justify-content-center align-content-center flex-wrap w-80 mx-auto">
  
      <div class="row">
          {# <div class="card-container"> #}
          {% for job in jobs %}
      <div class="card d-flex shadow-lg" style="width: 16rem;">
          <img src="{{asset('images/' ~ job.jobIamge)}}" class="card-img-top mx-auto card-image-size" alt="Image">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><b>{{job.jobName}}</b></h5>
            <p class="card-text">{{job.companyName}}</p>
            <div class="mt-auto">
                                                      
                <a href="/details/{{job.id}}" class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm"><span>Detail</span></a>
            </div>                      
          </div>
        </div>
        {% endfor %}
         
         </div>

     
</div>
 
{% endif %}

{% endif %}


{% endblock %}





