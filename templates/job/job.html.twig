      <a class="btn btn-outline-info form-control-lg text-dark form-border m-3 form-btn-border px-md-5 btn-lg " href="{{ path('app_edit',{"id": job.id}) }}">Edit</a> 
      <a class="btn btn-outline-info form-control-lg text-dark form-border m-3 form-btn-border px-md-5 btn-lg " href="{{ path('app_delete',{"id": job.id}) }}">Delete</a> 

