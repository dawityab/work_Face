{% extends 'base.html.twig' %}

{% block title %}Hello JobController!{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">WorkFace</a>
    <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
       <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
       {% if is_granted('ROLE_ADMIN') %}   
        <li class="nav-item">
          <a class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm" aria-current="page" href="/create">Add New Job</a>
        </li>
        {% endif %}
        <li class="nav-item">
          <a  class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm "
   href="/{{app.user ? 'logout' : 'login'}}">
<span>{{app.user ? 'Logout' :  'Login'}}</span>
</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm" href="/"><span>Home</span></a>
        </li>
        <li class="nav-item">
          {# <a class="nav-link disabled" href="/delete">Show a detail of a Job</a> #}
        </li>
      </ul>
    </div>
  </div>
</nav>
