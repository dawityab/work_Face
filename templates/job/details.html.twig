{% extends 'base.html.twig' %}

{% block title %}Job Details!{% endblock %}

{% block body %}


<div class="d-flex details-pages justify-content-center align-content-center flex-wrap w-80 mx-auto">
   
    
    
  




<div class="card mb-3" style="max-width: 18rem;">
  <div class="row g-0">
    
     <img src="{{asset('images/' ~ job.jobIamge)}}" class="img-fluid rounded-start" alt="It was a Job image">
   
      {# <img src="{{asset('build/images/image1.dd7a3cff.jpg')}}" class="img-fluid rounded-start" alt="It was a Job image"> #}
   
   
      <div class="card-body">
      <h1 class="bg-secondary text-light fs-1 p-2 m-2">{{ job.companyName }}</h1>
   
        <h5 class="card-title bg-info p-2 m-2">{{job.jobName}}</h5>
        <p class="card-text">{{job.jobDescription}}</p>
         <p class="card-text">€{{job.jobSalary}}</p>
        <p class="card-text">Posted on:<small class="text-muted">{{job.jobPostedDate|date('F j, Y, g:i a')}}</small></p>
     
      </div>
  
  </div>
</div>
   
</div> 
      <div class="d-flex w-80 justify-content-center align-content-center flex-wrap w-80 mx-auto">

        {% if is_granted('ROLE_ADMIN') %}   
         <a href="/job" class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center"><span class="mx-auto">More Jobs</span>
        </a>

        <a href="/" class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center"><span class="mx-auto">Back to home</span>
        </a>

        {# <a href="/" class="btn btn-outline-info text-dark form-border  form-btn-border  btn-sm">Back to home</a>  #}
        {# <a href="/job" class="btn btn-outline-info text-dark form-border  form-btn-border btn-sm">More jobs</a>  #}

        {% else %}
        
        <a  class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center "href="/{{app.user ? 'apply' : 'login'}}">
          <span class="mx-auto">{{app.user ? 'Apply Now' :  'To apply this job Please Login'}}</span>
        </a>
        <a href="/" class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center"><span class="mx-auto">Back to home</span>
        </a> 
        <a href="/job" class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center"><span class="mx-auto">More Jobs</span>
        </a>
        {% endif %}


      </div>



{% endblock %}

