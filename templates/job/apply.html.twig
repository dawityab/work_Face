{% extends 'base.html.twig' %}

{% block title %}Hello EventController!{% endblock %}

{% block body %}
<style>
  
</style>



  
        





  <section >
 
    <div class="container apply-card w-80 my-2">
      <div class="row d-flex justify-content-center align-items-center">
        
          <div class="card" style="width: 60%;">
            <div class="card-body">
              <h2 class="text-uppercase text-center mb-5"><i class="bi bi-caret-down"></i>Application Form</h2>

            
             
               
            {{form_start(form)}} 
             
                   
            <div class="form-outline mb-4">

             {# {{form_widget(form)}} #}
              <div class="text-muted">{{ form_label(form.title) }}</div>  
              <div>{{ form_widget(form.title, {'attr': { 'class':'form-control form-control-lg form-border mb-3'}}) }}</div>

              <div class="text-muted">{{ form_label(form.gender) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.gender, {'attr': {'placeholder': 'Gende', 'class':'form-control form-control-lg form-border mb-3'}}) }}</div>

              <div class="text-muted">{{ form_label(form.firstName) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.firstName, {'attr': {'placeholder': 'First Name', 'class':'form-control form-control-lg form-border mb-3'}}) }}</div>

              <div class="text-muted">{{ form_label(form.lastName) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.lastName, {'attr': { 'class':'form-control form-control-lg form-border mb-3'}}) }}</div>

              <div class="text-muted">{{ form_label(form.email) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.email, {'attr': { 'class':'form-control form-control-lg form-border mb-3'}}) }}</div>

              <div class="text-muted">{{ form_label(form.country) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.country, {'attr': {'class':'form-control form-control-lg form-border mb-3'}}) }}</div>

              <div class="text-muted">{{ form_label(form.cv) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.cv, {'attr': {'class':'form-control form-control-lg form-border mb-3  '}}) }}</div>

              <div class="text-muted">{{ form_label(form.attachments) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.attachments, {'attr': { 'class':'form-control form-control-lg form-border mb-3  '}}) }}</div>

              <div class="text-muted">{{ form_label(form.coverLetter) }}<span class="text-danger">*</span></div>  
              <div>{{ form_widget(form.coverLetter, {'attr': { 'class':'form-control form-control-lg form-border mb-3  '}}) }}</div>

            </div>
          
           
           {{form_end(form)}}

                
                 <a href="/job" class="btn btn-outline-info  text-dark form-border m-3 form-btn-border m-3 px-4 btn-sm">More jobs</a>      
           
                
            
            {# <div class="d-flex justify-content-center">
                  <button type="button"
                    class="btn btn-success btn-block btn-lg gradient-custom-4 text-body">Register</button>
                </div>

                <p class="text-center text-muted mt-5 mb-0">Have already an account? <a href="#!"
                    class="fw-bold text-body"><u>Login here</u></a></p>

            
            {{ form_end(registrationForm) }}

            

        </div> #}
    </div>
    
            </div>
          </div>
        </div>
      </div>
    </div>
  
</section>

 {% for message in app.flashes('success') %}

        <div class="alert alert-success">
            {{ message }}
        </div>

{% endfor %}


 
