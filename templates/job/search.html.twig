{% extends 'base.html.twig' %}

{% block title %}Search result {% endblock %}


{% block body %}

    <div class="d-flex search-page-container justify-content-center align-content-center flex-wrap w-80 mx-auto">

      {% if searchJobs|length < 1 %}
      <h3 class="text-uppercase text-center m-5 p-3 bg-info text-dark job-info "><b>0 result found</b></h3>
      {% else %}
      {% for e in searchJobs %}

        {# {{ app.session.get('data')}}  #}

           
              <div class="row">
                <div class="col-md">
                 <div class="card" style="width: 18rem;">
                  <img src="{{asset('images/' ~ e.jobIamge)}}" class="img-fluid rounded-start" alt="It was a Job image">
                 
                  {# <img src="{{asset('build/images/image1.dd7a3cff.jpg')}}" class="img-fluid rounded-start" alt="It was a Job image"> #}
               
                  <div class="card-body">
                  <h5 class="card-title">{{e.jobName}}</h5>
                  <p class="card-title">{{e.companyName}}</p>
                  <p class="card-title">{{e.jobLocation}}</p>
                  <p class="card-text">Posted on:<small class="text-muted">{{e.jobPostedDate|date('F j, Y, g:i a')}}</small></p> 
                  <a href="/details/{{e.id}}" class="btn btn-outline-info form-control-sm text-dark form-border m-1 form-btn-border px-sm-5 btn-sm m-1 d-flex justify-content-center"><span class="mx-auto">Detail</span></a>

                    </div>
                 </div>
            </div>
          
    </div>
                
                {% endfor %}
                {% endif %}
              
             
</div>
<div class="container d-flex search-page-container justify-content-center align-content-center flex-wrap w-80 mx-auto">
    <div class="row">
          <div class="col-md">
          <a href="/" class="btn btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm"><span>Back</span></a>
          </div>
          
    </div>
</div>

{% endblock %}