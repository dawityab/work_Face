{% extends 'base.html.twig' %}

{% block title %}Hello JobController!{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">WorkFace</a>
    <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
       <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
       {% if is_granted('ROLE_ADMIN') %}   
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/create">Add New Job</a>
        </li>
        {% endif %}
        <li class="nav-item">
          <a  class="btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm "
        href="/{{app.user ? 'logout' : 'login'}}">
        {{app.user ? 'Logout' :  'Login'}}
        </a>
        </li>
        <li class="nav-item">
         {% if jobs is empty %}
         <p class="text-uppercase text-center m-5 bg-warning text-secondary ">0 result found</p>
         {% else %}
           <a  class="btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm " href="/job">
                Job
           </a>
           {% endif %}
        </li>
        <li class="nav-item">
          {# <a class="nav-link disabled" href="/delete">Show a detail of a Job</a> #}
        </li>
      </ul>
    </div>
  </div>
</nav>

<div class="d-flex w-80 justify-content-center align-content-center flex-wrap w-80 mx-auto">
   
    {# {% if not is_granted('ROLE_ADMIN') %}  #}
      {# <p class="text-uppercase text-center m-5 bg-warning text-secondary ">{{app.user.email}}</p> #}
      {# <p class="text-uppercase text-center m-5 bg-warning text-secondary ">Welcome back</p>  #}
    {# {% endif %} #}
  
     {# <a href="/login" class="btn btn-outline-info form-control-lg text-dark form-border m-3 form-btn-border px-md-5 btn-lg ">Login</a>  #}
    {{ form_start(form) }}
<div class="form-group m-2 my-3">
    <label for="{{ form.jobCatagory.vars.id }}">Job Catagory</label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-tag"></i></span>
        {{ form_widget(form.jobCatagory, {'attr': {'class': 'form-control', 'placeholder': 'Catagory'}}) }}
    </div>
</div>
<div class="form-group m-2">
    <label for="{{ form.jobLocation.vars.id}}">Job Location</label>
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
        {{ form_widget(form.jobLocation, {'attr': {'class': 'form-control', 'placeholder': 'Job Location'}}) }}
    </div>
</div>
{{ form_row(form.search, {'label': 'Find Job', 'attr' : {'class' : 'btn btn-outline-info  text-dark form-border m-3 px-4 form-btn-border btn-sm'}} ) }}

{{ form_end(form) }}
   
    {# {{ form_start(form) }}  #}
    
    
      {# {{ form_row(form.jobCatagory, {'widget': 'icon','attr' : {'class' : 'form-control-sm form-border m-3 p-2 '}} ) }} #}
      {# {{ form_row(form.jobLocation, {'attr' : {'class' : 'form-control-sm form-border m-3 p-2'}} ) }} #}
      {# {{ form_row(form.search, {'label': 'Find Job', 'attr' : {'class' : 'btn btn-outline-info  text-dark form-border m-3 px-4 form-btn-border btn-sm'}} ) }} #}

    {# {{ form_end(form) }}   #}

</div>

</div>
</div>

{% endblock %}

