{% extends 'base.html.twig' %}

{% block title %}Hello JobController!{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
  
    <a class="navbar-brand" href="/"><img src="{{ asset('images/jf-image.png') }}" alt="Image" class="logo-img">
   
    </a>

    <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
       <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
       {% if is_granted('ROLE_ADMIN') %}   
        <li class="nav-item">
          <a class="nav-link active btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm " aria-current="page" href="/create">Add New Job</a>
        </li>
        {% endif %}
        {% if not is_granted('IS_AUTHENTICATED_FULLY')%}
         <li class="nav-item">
          <a  class="btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm "
        href="/register"><span>Sign Up</span>
        <a  class="btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm "
        href="/login"><span>Sign In</span>
        </a>
        </li>
        {% else %}
        <li class="nav-item">
          <a  class="btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm "
        href="/{{app.user ? 'logout' : 'login'}}">
        <span>{{app.user ? 'Logout' :  'Login'}}</span>
        </a>
        </li>
        {% endif %}
        <li class="nav-item">
         {% if jobs is empty %}
         <p class="text-uppercase text-center m-5 bg-warning text-secondary ">0 result found</p>
         {% else %}
           <a  class="btn btn-outline-info  text-dark form-border m-3 form-btn-border px-md-5 btn-sm" href="/job"><span>Job</span>
                
           </a>
           {% endif %}
        </li>
        <li class="nav-item">
          {# <a class="nav-link disabled" href="/delete">Show a detail of a Job</a> #}
        </li>
      </ul>
    </div>
  </div>
</nav>


</div>
</div>


<div class="container landing-page-background d-flex justify-content-center align-content-center flex-wrap w-80 mx-auto">
  <div class="row">
    <div class="col-md-6 land-page-search-col">
          <div class="d-flex justify-content-center align-content-center flex-wrap  mx-auto">

              <div class="jumbotron">
              <h1 class="jumbo-text">Search Your Dream Job</h1>
              </div>
   
            {{ form_start(form) }}
                <div class="form-group m-2 my-3">
                    <label for="{{ form.jobCatagory.vars.id }}">Job Catagory</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-tag"></i></span>
                        {{ form_widget(form.jobCatagory, {'attr': {'class': 'form-control', 'placeholder': 'Catagory'}}) }}
                    </div>
                </div>
                <div class="form-group m-2">
                    <label for="{{ form.jobLocation.vars.id}}">Job Location</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                        {{ form_widget(form.jobLocation, {'attr': {'class': 'form-control', 'placeholder': 'Job Location'}}) }}
                    </div>
                </div>
                  {{ form_row(form.search, {'label': 'Find Job', 'attr' : {'class' : 'btn  btn-outline-info text-dark form-border m-3 form-btn-border px-md-5 btn-sm find-job'}} ) }}

            {{ form_end(form) }}
   
          </div>

    </div>

  
          <div class="col-md-6 landing-page-image ">
         
           <img src="{{ asset('https://cdn.smartrecruiters.com/blog/wp-content/uploads/2022/02/AttraxCampaign_BlogHeader.jpg') }}" alt="Image" class="img-fluid w-100 h-100" >
          </div>
    
  </div>
</div>
<div class="container d-flex justify-content-center align-content-center flex-wrap w-100 mx-auto ">
      <div class="row">
            <div class="col-md-4 card-container-landing ">
                  <div class="card landing-cards text-center shadow-lg" style="width: 16rem;">
                    
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                              
                              <i class="fa-solid fa-circle-nodes"></i>

                              <h3 class="landing-card-title">Networking</h3>
                              <p class="landing-card-text">For what reason would it be advisable for me to think about business content?</p>
                            
                        </div>
                        
                  </div>
            </div>

        <div class=" col-md-4 card-container-landing">
                  <div class="card landing-cards text-center shadow-lg" style="width: 16rem;">
                    
                        <div class="card-body d-flex flex-column justify-content-center align-items-center">
                              
                              <i class="fa-solid fa-users"></i>

                              <h3 class="landing-card-title">Social Activity</h3>
                              <p class="landing-card-text">For what reason would it be advisable for me to think about business content?</p>
                            
                        </div>
                        
                  </div>
            </div>

         <div class="col-md-4 card-container-landing">
                  <div class="card landing-cards text-center shadow-lg" style="width: 16rem;">
                    
                        <div class=" card-body d-flex flex-column justify-content-center align-items-center">
                              
                              <i class="fa-solid fa-comment"></i>

                              <h3 class="landing-card-title">Consulting</h3>
                              <p class="landing-card-text">For what reason would it be advisable for me to think about business content?</p>
                            
                        </div>
                        
                  </div>
            </div>

      </div>
      
</div>

