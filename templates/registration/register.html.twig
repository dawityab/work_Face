{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container-sign-up">
      <div class="sign-up-wave">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
                  <path fill="#000b76" fill-opacity="0.5" d="M0,224L40,202.7C80,181,160,139,240,144C320,149,400,203,480,192C560,181,640,107,720,85.3C800,64,880,96,960,122.7C1040,149,1120,171,1200,176C1280,181,1360,171,1400,165.3L1440,160L1440,0L1400,0C1360,0,1280,0,1200,0C1120,0,1040,0,960,0C880,0,800,0,720,0C640,0,560,0,480,0C400,0,320,0,240,0C160,0,80,0,40,0L0,0Z"></path>
                   <path fill="#0099ff" fill-opacity="0.5" d="M0,96L48,122.7C96,149,192,203,288,213.3C384,224,480,192,576,160C672,128,768,96,864,101.3C960,107,1056,149,1152,144C1248,139,1344,85,1392,58.7L1440,32L1440,0L1392,0C1344,0,1248,0,1152,0C1056,0,960,0,864,0C768,0,672,0,576,0C480,0,384,0,288,0C192,0,96,0,48,0L0,0Z"></path>

              </svg>
        </div>
    <section class="sign-up container container d-flex justify-content-center align-items-center ">
  <div class="mask d-flex align-items-center  ">
    <div class="container ">
      <div class="row d-flex justify-content-center align-items-center">
        <div class="col-md-12">
          <div class="card" style="width: 16rem;">
            <div class="card-body ">
              <h2 class="text-uppercase text-center mb-5 title-border bg-secondary">Create an account</h2>

            
             
               
            {{ form_start(registrationForm) }}

              <div class="form-outline mb-4">
              <div class="input-group"> 
            
       
                {{ form_row(registrationForm.email, {'attr': {'class': ' form-control form-control-lg sign-up-input', 'placeholder': 'User Email'}}) }}
             
             </div>
             </div>

              <div class="form-outline mb-4">
              <div class="input-group"> 
             
       
                    {{ form_row(registrationForm.plainPassword, {'attr': {'class': ' form-control form-control-lg sign-up-input', 'placeholder': 'User Password'}} ) }}
            </div>
             </div>
            <div class="form-outline mb-4">
            <div class="input-group"> 
          
              
                     {{ form_row(registrationForm.userName, {'attr': {'class': ' form-control form-control-lg sign-up-input', 'placeholder': 'User Name'}} ) }}
            </div>
            </div>
            <div class="form-check d-flex justify-content-center mb-4">
                 
              
                    {{ form_row(registrationForm.agreeTerms) }}
                  
                </div>
              {{ form_end(registrationForm) }}    
            
            {# <div class="d-flex justify-content-center">
                  <button type="button"
                    class="btn btn-success btn-block btn-lg gradient-custom-4 text-body">Register</button>
                </div> #}

                <p class="text-center text-muted mt-5 mb-0">Have you already an account? <a href="#!"
                    class="fw-bold text-body"><u><a href="/{{app.user ? 'logout' : 'login'}}">{{ app.user ? 'Logout' : 'Login'}}</u></a></p>

            
          

            

        </div>
    </div>
    
            </div>
          </div>
        </div>
      </div>
    </div>
  
</section>
{# <div class="container">
    <div class="row">
        <div class="col-6 align-self-center">
            <div class="card card-body">Center</div>
        </div>
        <div class="col-6">
            <div class="card text-white bg-danger">
                <div class="card-body">
                    <h3 class="card-title">Taller</h3>
                    <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
                    <a href="#" class="btn text-white border-light">Outline</a>
                </div>
            </div>
        </div>
    </div>
</div #}
{% endblock %}